# =======================================================
# Maison Élanor Frontend (Next.js) Environment Variables
# =======================================================
# TEMPLATE FILE ONLY (Placeholders)
# Copy this file to .env.local and insert your real secrets.
# NEVER commit real credentials to GitHub.

# Razorpay Test Mode Key (Public)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Secret (Keep secure, for server/webhook verification)
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Shiprocket Free Sandbox Logistics
SHIPROCKET_EMAIL=your_shiprocket_email@domain.com
SHIPROCKET_PASSWORD=your_shiprocket_api_password_here
SHIPROCKET_WEBHOOK_TOKEN=your_shiprocket_webhook_token_here

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
