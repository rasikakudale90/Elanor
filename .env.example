# Maison Élanor — Environment Configuration Template
# Copy this file to .env.local for Next.js or set in your hosting platform (e.g. Vercel)

# Razorpay Test Mode Key (Public)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_51a0Hk6b62D7X9

# Razorpay Secret (Keep secure, for server/webhook verification)
RAZORPAY_KEY_SECRET=rzp_secret_dummy_replace_with_yours
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_dummy

# Shiprocket Free Sandbox Logistics (Optional for Live API sync)
SHIPROCKET_EMAIL=your_email@domain.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_WEBHOOK_TOKEN=sr_webhook_token_dummy

# Backend API URL (Optional if proxying)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
