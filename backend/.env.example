# =======================================================
# Maison Élanor Backend (Spring Boot) Environment Variables
# =======================================================
# When deploying to Render.com, add these in the Render Environment tab.
# For local development, copy this file to backend/.env

# Database (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://db.YOUR_SUPABASE_ID.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

