# =======================================================
# Maison Élanor Backend (Spring Boot) Environment Variables
# =======================================================
# TEMPLATE FILE ONLY (Placeholders)
# Copy this file to backend/.env and insert your real secrets.
# NEVER commit real credentials to GitHub.

# Database (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password_here

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:3000

# Security (JWT Secret Key - 256-bit Hex)
JWT_SECRET=your_jwt_secret_key_hex_here

# Shiprocket Free Sandbox & Logistics
SHIPROCKET_EMAIL=your_shiprocket_email@domain.com
SHIPROCKET_PASSWORD=your_shiprocket_api_password_here
SHIPROCKET_WEBHOOK_TOKEN=your_shiprocket_webhook_token_here

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
